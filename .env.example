# Postgres — основной путь: connection string облака (Neon / Render)
# DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

# Опционально: локальный Postgres (docker compose)
# DATABASE_URL=postgresql://assessment:assessment@localhost:5432/assessment

# API (локальный `npm run dev` в server/ или env на Render/Fly)
PORT=3000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://metaloziz.github.io

# Frontend: URL задеплоенного API (dev через app/.env.local или prod build / CI)
# Без переменной Vite проксирует /api → http://localhost:3000
# VITE_API_BASE_URL=https://your-api.onrender.com
