# Postgres — основной путь: Render Blueprint (assessment-db), как meme-app
# Локально можно подставить свой URL:
# DATABASE_URL=postgresql://assessment:assessment@localhost:5432/assessment

# API (локальный `npm run dev` в server/ или env на Render)
PORT=3000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://metaloziz.github.io

# Frontend: URL API на Render (dev: app/.env.local; prod: GitHub Actions secret)
# Без переменной Vite проксирует /api → http://localhost:3000
# VITE_API_BASE_URL=https://assessment-api.onrender.com
