# Postgres — основной путь: Render Blueprint (assessment-db), как meme-app
# Локально можно подставить свой URL:
# DATABASE_URL=postgresql://assessment:assessment@localhost:5432/assessment

# API (локальный `npm run dev` в server/ или env на Render)
PORT=3000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://metaloziz.github.io

# Dev: app/.env.development (remote-first → Render). Override: app/.env.development.local
# Prod: GitHub Actions secret VITE_API_BASE_URL
# Локальный server: VITE_API_BASE_URL=http://localhost:3000
VITE_API_BASE_URL=https://assessment-api-fm0e.onrender.com

# Sentry — только фронт (optional; без DSN SDK не инициализируется)
# Prod: GitHub Actions secrets VITE_SENTRY_DSN, SENTRY_AUTH_TOKEN, SENTRY_ORG, SENTRY_PROJECT
VITE_SENTRY_DSN=
VITE_APP_RELEASE=local
